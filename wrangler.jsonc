{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ntpu-ai-cloudflare-worker",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "BACKEND_ORIGIN": "https://ntpu-router-495790502594.asia-east1.run.app"
  },
  "observability": {
    "enabled": true
  }
}
