{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ntpu-ai-cloudflare-worker",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna",
    "OPENAI_JUDGE_MODEL": "gpt-5.6-luna",
    "ADMIN_EMAIL": "aintpu@gmail.com",
    "EMAIL_FROM": "noreply@ntpu.ai"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ntpu-ai-worker-db",
      "database_id": "20e20d0c-78d4-42ae-8348-fcb5cd78b6fc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "ntpu-ai-worker-uploads"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@ntpu.ai"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
